language js(typescript)

// scope: global

// A warning, never an error, because `typeof` is the only correct way to narrow
// an `unknown` at a trust boundary, and this repository is full of them: IPC
// payloads, `JSON.parse` results, ACP frames, Team API frames, `localStorage`
// reads, and anything crossing the renderer-to-main boundary. A decoder that
// branches on `typeof` there is right, and this rule cannot tell that case from
// the one it exists for: a `typeof` on a value whose type the compiler already
// knows, which throws away type evidence the caller handed you.
//
// The signal is where the value came from. Inside a parse or decode function
// that takes `unknown`, ignore this. Anywhere the operand has a declared domain
// type, the check is redundant and the branch it guards is unreachable or the
// type is a lie.
`typeof $value` as $check where {
  register_diagnostic(
    span=$check,
    message="Check whether this typeof narrows an unknown at a trust boundary or a value whose type is already known. See AGENTS.md: the first is correct and this warning can be ignored; the second discards type evidence, so parse the input at its boundary and branch on the domain value.",
    severity="warn"
  )
}
