{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "plugins": [
    "./tools/biome/anti-slop/rules/no-chained-type-assertions.grit",
    "./tools/biome/anti-slop/rules/no-collections-in-stores.grit",
    "./tools/biome/anti-slop/rules/no-known-value-widening.grit",
    "./tools/biome/anti-slop/rules/no-module-mocking.grit",
    "./tools/biome/anti-slop/rules/no-object-parameters.grit",
    "./tools/biome/anti-slop/rules/no-reflect-escapes.grit",
    "./tools/biome/anti-slop/rules/no-runtime-typeof.grit",
    "./tools/biome/anti-slop/rules/no-shape-in-symbol-names.grit",
    "./tools/biome/anti-slop/rules/no-unknown-returns.grit",
    "./tools/biome/anti-slop/rules/no-unknown-type-aliases.grit",
    "./tools/biome/anti-slop/rules/no-unsafe-dictionary-type.grit"
  ],
  "files": {
    "includes": [
      "**",
      "!.codex",
      "!.claude",
      "!node_modules",
      "!out",
      "!out-dev-app",
      "!out-dev-test-client",
      "!build",
      "!dist",
      "!storybook-static",
      "!**/dist",
      "!**/.wrangler",
      "!apps/mobile/.expo",
      "!apps/mobile/android",
      "!apps/mobile/ios",
      "!apps/mobile/expo-env.d.ts",
      "!apps/mobile/src/uniwind-types.d.ts",
      "!**/routeTree.gen.ts",
      "!tools/biome/anti-slop",
      "!tools/ui-foundation/fixtures",
      "!coverage",
      "!.openbot-build",
      "!.worktrees",
      "!build/whisper",
      "!.agents",
      "!src/renderer/src/vendor"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input", "Textarea", "NativeSelect"]
          }
        }
      },
      "complexity": {
        "noBannedTypes": "error",
        "noUselessTypeConstraint": "error"
      },
      "nursery": {
        "noMisleadingReturnType": "error",
        "noUnsafeTypeAssertion": "error",
        "useReduceTypeParameter": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useAsConstAssertion": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noImportCycles": "error",
        "noSkippedTests": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/renderer/src/styles/app-shell.css", "src/renderer/src/styles/conversation.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "scripts/**/*.ts",
        "packages/**/*.ts",
        "!scripts/build-remote-desktop-runtime.ts",
        "!scripts/create-remote-desktop-release-manifest.ts",
        "!scripts/native-runtime-lock.ts",
        "!scripts/package-remote-desktop-runtime.ts",
        "!scripts/remote-desktop-runtime-release.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.ts", "src/**/*.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "plugins": [
        "./tools/biome/anti-slop/rules/no-class-assertions.grit",
        "./tools/biome/anti-slop/rules/no-style-assertions.grit",
        "./tools/biome/anti-slop/rules/no-dom-containment-assertions.grit",
        "./tools/biome/anti-slop/rules/no-title-copy-assertions.grit",
        "./tools/biome/anti-slop/rules/no-active-element-assertions.grit",
        "./tools/biome/anti-slop/rules/no-inner-html-assertions.grit",
        "./tools/biome/anti-slop/rules/no-dom-traversal-assertions.grit",
        "./tools/biome/anti-slop/rules/no-icon-query-assertions.grit",
        "./tools/biome/anti-slop/rules/no-snapshot-tests.grit",
        "./tools/biome/anti-slop/rules/no-testid-queries.grit",
        "./tools/biome/anti-slop/rules/no-class-selector-queries.grit",
        "./tools/biome/anti-slop/rules/no-sleep-in-tests.grit"
      ]
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    },
    "jsxRuntime": "transparent"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
