{
  "name": "openbot",
  "productName": "OpenBot",
  "version": "0.4.3",
  "description": "A local-first multi-agent desktop workspace for Codex, Claude, and Grok.",
  "author": {
    "name": "Norbert Bodziony",
    "url": "https://x.com/norbertbodziony"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NorbertBodziony/openbot.git"
  },
  "bugs": {
    "url": "https://github.com/NorbertBodziony/openbot/issues"
  },
  "homepage": "https://github.com/NorbertBodziony/openbot#readme",
  "keywords": [
    "ai-agents",
    "bun",
    "claude-code",
    "codex",
    "electron",
    "local-first",
    "solidjs"
  ],
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "remote/api"
    ],
    "catalog": {
      "@cloudflare/workers-types": "5.20260815.1",
      "@fontsource-variable/inter": "5.3.0",
      "@kobalte/core": "2.0.0-alpha.0",
      "@norbert_bodziony/bloub": "0.2.1",
      "@openpanel/web": "1.4.1",
      "@solidjs/signals": "2.0.0-rc.0",
      "@solidjs/testing-library": "1.0.0-beta.2",
      "@solidjs/vite-plugin": "3.0.0-next.28",
      "@solidjs/web": "2.0.0-rc.0",
      "@tailwindcss/vite": "4.3.3",
      "@testing-library/jest-dom": "7.0.1",
      "@types/node": "24.13.3",
      "class-variance-authority": "0.7.1",
      "fflate": "0.8.2",
      "jose": "6.2.10",
      "jsdom": "30.0.1",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "vite": "7.3.6",
      "vitest": "4.1.10",
      "wrangler": "4.123.0",
      "yaml": "2.8.3",
      "zod": "4.5.4"
    }
  },
  "main": "./out/main/index.js",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "bun scripts/install-git-hooks.ts",
    "postinstall": "install-electron",
    "api:start": "bun run --cwd apps/auth-api start",
    "api:build": "bun run --cwd apps/auth-api build",
    "api:deploy": "bun run --cwd apps/auth-api deploy",
    "api:deploy:test": "bun run --cwd apps/auth-api deploy:test",
    "sites:deploy": "bun run --cwd apps/site-router deploy",
    "sites:bucket:create": "bunx wrangler r2 bucket create openbot-sites --storage-class Standard",
    "sites:lifecycle": "bunx wrangler r2 bucket lifecycle set openbot-sites --file apps/site-router/r2-lifecycle.json --force",
    "api:migrate:local": "bun run --cwd apps/auth-api db:migrate:local",
    "api:migrate:remote": "bun run --cwd apps/auth-api db:migrate:remote",
    "remote:up": "remote/bin/dotenvx run --overload -f remote/.env.production -fk remote/.env.keys -- docker compose -f remote/compose.yaml up -d --build",
    "remote:down": "remote/bin/dotenvx run --overload -f remote/.env.production -fk remote/.env.keys -- docker compose -f remote/compose.yaml down",
    "remote:logs": "remote/bin/dotenvx run --overload -f remote/.env.production -fk remote/.env.keys -- docker compose -f remote/compose.yaml logs -f remote-api coturn",
    "remote:check": "bun remote/scripts/check.ts",
    "remote:env:validate": "cd remote && bin/dotenvx validate -f .env.production -fk .env.keys",
    "remote:update": "remote/bin/dotenvx run --overload -f remote/.env.production -fk remote/.env.keys -- bun remote/scripts/update.ts",
    "env:encrypt:dev": "bun run --cwd apps/auth-api env:encrypt:dev",
    "env:encrypt:prod": "bun run --cwd apps/auth-api env:encrypt:prod",
    "env:set:smtp": "bun run --cwd apps/auth-api env:set:smtp",
    "env:validate:dev": "bun run --cwd apps/auth-api env:validate:dev",
    "env:validate:prod": "bun run --cwd apps/auth-api env:validate:prod",
    "dev:prepare": "bun scripts/prepare-dev-environment.ts",
    "dev": "bun scripts/dev-services.ts app",
    "dev:api": "bun scripts/dev-services.ts api",
    "dev:test-client": "bun scripts/dev-services.ts test-client",
    "dev:all": "bun scripts/dev-services.ts all",
    "mobile": "bun run --cwd apps/mobile start",
    "mobile:android": "bun run --cwd apps/mobile android",
    "mobile:ios": "bun run --cwd apps/mobile ios",
    "mobile:lint": "bun run --cwd apps/mobile lint",
    "mobile:typecheck": "bun run --cwd apps/mobile typecheck",
    "mobile:doctor": "bun run --cwd apps/mobile doctor",
    "dev:seed": "tsx scripts/seed-dev-state.ts",
    "dev:reset": "tsx scripts/reset-dev-state.ts",
    "analytics:backfill": "bun scripts/backfill-openpanel-identities.ts",
    "build": "electron-vite build",
    "voice:prepare": "bun scripts/prepare-whisper.ts",
    "voice:prepare-runtime": "bun scripts/prepare-whisper.ts --runtime-only",
    "build:remote-desktop-runtime": "bun scripts/build-remote-desktop-runtime.ts",
    "install:remote-desktop-runtime": "bun scripts/install-remote-desktop-runtime.ts",
    "prepare:remote-desktop-runtime": "bun scripts/prepare-remote-desktop-runtime.ts",
    "package:remote-desktop-runtime": "bun scripts/package-remote-desktop-runtime.ts",
    "install:codex-runtime": "bun scripts/install-codex-runtime.ts",
    "install:claude-runtime": "bun scripts/install-claude-runtime.ts",
    "install:grok-runtime": "bun scripts/install-grok-runtime.ts",
    "verify:remote-desktop-runtime": "bun scripts/verify-remote-desktop-runtime.ts",
    "preview": "bun scripts/preview.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:storybook": "tsc --noEmit -p tsconfig.storybook.json",
    "typecheck:api": "bun run --cwd apps/auth-api typecheck",
    "typecheck:brand": "bun run --cwd packages/brand typecheck",
    "typecheck:contracts": "bun run --cwd packages/contracts typecheck",
    "typecheck:sites": "bun run --cwd apps/site-router typecheck",
    "typecheck:team-client": "bun run --cwd packages/team-client typecheck",
    "typecheck": "bun run --parallel 'typecheck:*'",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:staged": "biome check --write --staged --files-ignore-unknown=true --no-errors-on-unmatched",
    "test": "bun run test:desktop && bun run test:api && bun run test:sites",
    "test:desktop": "vitest run",
    "test:api": "bun run --cwd apps/auth-api test",
    "test:contracts": "bun run --cwd packages/contracts test",
    "test:sites": "bun run --cwd apps/site-router test",
    "test:backend": "vitest run src/backend",
    "test:browser": "bun scripts/browser-smoke.ts",
    "test:browser:google-live": "bun scripts/browser-smoke.ts --google-live",
    "test:codex": "bun scripts/codex-doctor.ts --strict",
    "test:filesystem": "bun scripts/filesystem-smoke.ts",
    "test:imagegen": "bun scripts/filesystem-smoke.ts --provider codex --imagegen",
    "test:storage-live": "bun scripts/provider-storage-smoke.ts",
    "test:grok-live": "bun scripts/provider-storage-smoke.ts --grok-only",
    "test:team-live": "electron scripts/team-webrtc-live-smoke-app",
    "test:remote-desktop-runtime": "bun scripts/remote-desktop-runtime-smoke.ts",
    "codex:doctor": "bun scripts/codex-doctor.ts",
    "skills:review": "bun scripts/review-skills.ts",
    "marketplace:build": "bun scripts/build-production-catalog.ts",
    "marketplace:publish:production": "bun scripts/publish-production-catalog.ts",
    "agents:review": "bun scripts/review-agents.ts",
    "agents:seed": "bun scripts/seed-marketplace-agents.ts",
    "skills:seed": "bun scripts/seed-marketplace-skills.ts",
    "release:preflight": "bun scripts/release-preflight.ts",
    "release:patch": "bun scripts/prepare-release.ts patch",
    "release:minor": "bun scripts/prepare-release.ts minor",
    "release:major": "bun scripts/prepare-release.ts major",
    "check": "bun run --parallel check:desktop check:api test:sites && bun run test:desktop",
    "check:desktop": "bun run check:ui && bun run lint && bun run desktop:typecheck && bun run test:browser && bun run build",
    "check:api": "bun run typecheck:api && bun run test:api && bun run api:build:check",
    "desktop:typecheck": "bun run --parallel typecheck:node typecheck:renderer typecheck:contracts typecheck:brand typecheck:storybook",
    "api:build:check": "CLOUDFLARE_ENV=preview bun run api:build",
    "check:ui": "bun scripts/ui-foundation-check.ts",
    "package": "bun run voice:prepare-runtime && bun run prepare:remote-desktop-runtime && bun run verify:remote-desktop-runtime && bun run build && electron-builder --dir --mac --arm64 --config.mac.identity=null --config.mac.notarize=false",
    "verify:package": "bun scripts/verify-macos-package.ts",
    "package:verify": "bun run package && bun run verify:package",
    "package:win": "bun run voice:prepare-runtime && bun scripts/prepare-remote-desktop-runtime.ts win32 x64 && bun run verify:remote-desktop-runtime --windows && bun run build && electron-builder --dir --win --x64 --publish never",
    "verify:package:win": "bun scripts/verify-windows-package.ts",
    "verify:update-artifacts": "bun scripts/verify-update-artifacts.ts",
    "package:win:verify": "bun run package:win && bun run verify:package:win",
    "dist:mac": "bun run voice:prepare-runtime && bun run prepare:remote-desktop-runtime && bun run verify:remote-desktop-runtime && bun run build && electron-builder --mac --arm64 --config.mac.identity=null --config.mac.notarize=false",
    "dist:win": "bun run voice:prepare-runtime && bun scripts/prepare-remote-desktop-runtime.ts win32 x64 && bun run verify:remote-desktop-runtime --windows && bun run build && electron-builder --win nsis --x64 --publish never",
    "dist:release": "bun run voice:prepare-runtime && bun run prepare:remote-desktop-runtime && bun run verify:remote-desktop-runtime && bun run build && electron-builder --mac --arm64 --publish never"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.252",
    "@anthropic-ai/sdk": "0.122.0",
    "@fontsource-variable/inter": "catalog:",
    "@kobalte/core": "catalog:",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@norbert_bodziony/bloub": "catalog:",
    "@openbot/brand": "workspace:*",
    "@openbot/contracts": "workspace:*",
    "@openbot/team-client": "workspace:*",
    "@openpanel/web": "catalog:",
    "@solidjs/signals": "catalog:",
    "@solidjs/web": "catalog:",
    "@speed-highlight/core": "1.2.24",
    "@tanstack/virtual-core": "3.17.8",
    "class-variance-authority": "catalog:",
    "electron-updater": "6.8.9",
    "fflate": "catalog:",
    "jose": "catalog:",
    "lucide-solid": "1.38.0",
    "marked": "18.0.11",
    "qrcode": "^1.5.4",
    "solid-js": "2.0.0-rc.0",
    "solid-sonner": "0.3.2",
    "ws": "8.21.3",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@dotenvx/dotenvx": "^2.23.0",
    "@electron/fuses": "1.8.0",
    "@solidjs/testing-library": "catalog:",
    "@solidjs/vite-plugin": "catalog:",
    "@storybook/addon-a11y": "10.5.10",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "8.18.1",
    "electron": "44.1.0",
    "electron-builder": "26.15.7",
    "electron-vite": "5.0.0",
    "jsdom": "catalog:",
    "storybook": "^10.5.10",
    "storybook-solidjs-vite": "^10.7.1",
    "tailwindcss": "catalog:",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "patchedDependencies": {
    "lucide-solid@1.33.0": "patches/lucide-solid@1.33.0.patch",
    "@kobalte/core@2.0.0-alpha.0": "patches/@kobalte%2Fcore@2.0.0-alpha.0.patch",
    "dmg-builder@26.15.7": "patches/dmg-builder@26.15.7.patch",
    "solid-sonner@0.3.2": "patches/solid-sonner@0.3.2.patch"
  }
}
