{
  "name": "infeld-bot",
  "productName": "Infeld Bot",
  "version": "0.1.0",
  "description": "A local-first multi-agent desktop workspace powered by Codex App Server.",
  "author": {
    "name": "Norbert Bodziony",
    "url": "https://x.com/norbertbodziony"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightly-labs/openbot.git"
  },
  "bugs": {
    "url": "https://github.com/nightly-labs/openbot/issues"
  },
  "homepage": "https://github.com/nightly-labs/openbot#readme",
  "keywords": [
    "ai-agents",
    "bun",
    "codex",
    "electron",
    "local-first",
    "solidjs"
  ],
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "bun run typecheck:node && bun run typecheck:renderer",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:backend": "vitest run src/backend",
    "test:browser": "bun scripts/browser-smoke.ts",
    "test:codex": "bun scripts/codex-doctor.ts --strict",
    "test:filesystem": "bun scripts/filesystem-smoke.ts",
    "test:imagegen": "bun scripts/filesystem-smoke.ts --imagegen",
    "codex:doctor": "bun scripts/codex-doctor.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "package": "bun run build && electron-builder --dir --mac --arm64",
    "dist:mac": "bun run build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "22.20.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.10"
  }
}
